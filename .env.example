# Optional local defaults. Existing environment variables take precedence.
# Generate a unique API key with: openssl rand -hex 32
# Paste the generated value below. An empty API_KEY prevents startup.
API_KEY=

CONFIG_PATH=./config.yaml
MODEL_DIR=./inference/model
LISTEN_ADDR=:8080
# CPU inference can exceed short HTTP response deadlines. Must be positive.
WRITE_TIMEOUT=60s

# Defaults to the platform library installed by make deps.
# Set an absolute path for a custom runtime installation.
# Linux: /opt/onnxruntime/lib/libonnxruntime.so
# macOS: /opt/onnxruntime/lib/libonnxruntime.dylib
# ONNX_RUNTIME_PATH=

# Model setup is explicit; startup never downloads weights.
# Install the downloader: uv tool install huggingface_hub
# Download the pinned bundle: make model
# Use MODEL_DIR=/path/to/laya make model for a custom directory.
# Container setup needs no host hf CLI:
# docker compose run --build --rm model-download && docker compose up --build -d router
# Compose uses MODEL_DIR and CONFIG_PATH above as host bind-mount sources.
