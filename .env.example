# Optional defaults; exported environment values take precedence.
# Generate a key: openssl rand -hex 32. Empty API_KEY prevents startup.
API_KEY=
CONFIG_PATH=./config.yaml
MODEL_DIR=./inference/model
LISTEN_ADDR=:8080
# Positive Go duration; includes CPU routing time.
WRITE_TIMEOUT=60s

# Native override; otherwise uses the platform library from make deps.
# ONNX_RUNTIME_PATH=

# Compose treats CONFIG_PATH and MODEL_DIR as host paths.
# Make does not read this file; export MODEL_DIR for custom native downloads.
# Setup and persistent-storage commands: README.md.
